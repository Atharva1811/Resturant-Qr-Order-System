# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sudarshan_qr?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-for-sudarshan-development-only"
JWT_EXPIRES_IN="7d"

# Brevo Transactional Email (Email OTP)
# If empty or invalid, OTP requests run in local development mock mode (logging OTP to server console)
BREVO_API_KEY="xkeysib-placeholder-brevo-api-key"
BREVO_SENDER_EMAIL="orders@sudarshanqr.com"
BREVO_SENDER_NAME="Sudarshan QR Ordering"

# Frontend Origin for CORS & Socket.IO
FRONTEND_URL="http://localhost:5173"

# Payment Webhook HMAC Secret
PAYMENT_WEBHOOK_SECRET="whsec_sudarshan_test_secret_2026"
