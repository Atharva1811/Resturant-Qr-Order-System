# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/servora_qr?schema=public"

# Authentication & JWT
JWT_SECRET="super-secret-jwt-key-for-servora-development-only"
JWT_EXPIRES_IN="7d"

# Brevo Transactional Email (Email OTP Verification)
# Provide your actual Brevo API key to enable live transactional email delivery.
# If left empty in development/test, OTP requests run in safe mock mode without logging secrets.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="orders@servora.app"
BREVO_SENDER_NAME="Servora QR Ordering"

# Frontend Origin for CORS & Socket.IO Handshake
FRONTEND_URL="http://localhost:5173"

# Payment Webhook HMAC Secret
PAYMENT_WEBHOOK_SECRET="whsec_servora_test_secret_2026"

# Optional Razorpay Gateway Credentials
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Development-Only Guard (MUST be false or unset in production)
# When set to true and NODE_ENV !== 'production', allows verification with DEV_STATIC_OTP
ENABLE_DEV_OTP_BYPASS=false
DEV_STATIC_OTP="123456"

# Database Seeding Admin Password (Override in production/staging seeds)
SEED_ADMIN_PASSWORD="ChangeMeInProduction123!"
