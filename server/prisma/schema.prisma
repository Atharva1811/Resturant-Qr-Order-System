generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPERADMIN
  RESTAURANT_ADMIN
  KITCHEN_STAFF
  WAITER
}

enum StaffRole {
  RESTAURANT_ADMIN
  KITCHEN_STAFF
  WAITER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum CustomizationType {
  SINGLE
  MULTIPLE
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COUNTER
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Restaurant {
  id           String           @id @default(uuid())
  name         String
  slug         String           @unique
  cuisine      String
  logoUrl      String?
  bannerUrl    String?
  address      String
  phone        String
  email        String
  currency     String           @default("USD")
  taxRate      Float            @default(8.5)
  status       RestaurantStatus @default(ACTIVE)
  totalOrders  Int              @default(0)
  totalRevenue Float            @default(0.0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  users         User[]
  staff         RestaurantStaff[]
  tables        Table[]
  categories    MenuCategory[]
  menuItems     MenuItem[]
  orders        Order[]
  payments      Payment[]
  auditEvents   AuditEvent[]
  verifications CustomerVerification[]

  @@index([slug])
  @@index([status])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(RESTAURANT_ADMIN)
  restaurantId String?
  isActive     Boolean   @default(true)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant   Restaurant?      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staffProfile RestaurantStaff?
  auditEvents  AuditEvent[]

  @@index([email])
  @@index([restaurantId])
}

model RestaurantStaff {
  id           String      @id @default(uuid())
  restaurantId String
  userId       String?     @unique
  name         String
  email        String
  role         StaffRole   @default(KITCHEN_STAFF)
  status       StaffStatus @default(ACTIVE)
  avatarUrl    String?
  joinedDate   DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([email])
}

model Table {
  id           String      @id @default(uuid())
  restaurantId String
  tableNumber  String
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  qrToken      String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]
  verifications CustomerVerification[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
  @@index([qrToken])
}

model MenuCategory {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String?
  sortOrder    Int      @default(0)
  icon         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id              String   @id @default(uuid())
  restaurantId    String
  categoryId      String
  name            String
  description     String
  price           Float
  imageUrl        String?
  isAvailable     Boolean  @default(true)
  isVeg           Boolean  @default(false)
  prepTimeMinutes Int      @default(15)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category            MenuCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  customizationGroups CustomizationGroup[]
  orderItems          OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, isAvailable])
}

model CustomizationGroup {
  id         String            @id @default(uuid())
  menuItemId String
  name       String
  type       CustomizationType @default(SINGLE)
  required   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  menuItem MenuItem              @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  CustomizationOption[]

  @@index([menuItemId])
}

model CustomizationOption {
  id          String   @id @default(uuid())
  groupId     String
  name        String
  price       Float    @default(0.0)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group CustomizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model CustomerVerification {
  id           String    @id @default(uuid())
  email        String
  otpHash      String
  restaurantId String
  tableId      String?
  sessionToken String?   @unique
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  ipAddress    String?
  expiresAt    DateTime
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([email, restaurantId])
  @@index([sessionToken])
}

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String
  restaurantId        String
  tableId             String
  tableNumberSnapshot String
  customerName        String
  customerEmail       String
  subtotal            Float
  tax                 Float
  total               Float
  paymentMethod       PaymentMethod @default(COUNTER)
  paymentStatus       PaymentStatus @default(PENDING)
  status              OrderStatus   @default(NEW)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  restaurant  Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  table       Table         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  payments    Payment[]
  auditEvents AuditEvent[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  menuItemId        String?
  nameSnapshot      String
  unitPriceSnapshot Float
  quantity          Int
  itemTotal         Float
  notes             String?
  createdAt         DateTime @default(now())

  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?                @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  customizations OrderItemCustomization[]

  @@index([orderId])
}

model OrderItemCustomization {
  id                 String @id @default(uuid())
  orderItemId        String
  groupNameSnapshot  String
  optionNameSnapshot String
  priceDeltaSnapshot Float

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  restaurantId   String
  provider       String
  transactionId  String?       @unique
  amount         Float
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  rawPayload     String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([orderId])
  @@index([idempotencyKey])
}

model AuditEvent {
  id           String   @id @default(uuid())
  restaurantId String?
  userId       String?
  orderId      String?
  action       String
  details      String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  order      Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@index([action])
}
