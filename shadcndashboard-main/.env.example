# Servora Frontend — Public Environment Variables Template
# Backend API Base URL (Must be accessible from browser, e.g., https://servora-api.onrender.com/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Backend Real-time Socket.IO URL (Must be accessible from browser, e.g., https://servora-api.onrender.com)
VITE_SOCKET_URL=http://localhost:5000
