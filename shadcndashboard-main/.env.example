# Frontend Public Environment Variables
# Backend API Base URL (Must be accessible from browser, e.g. https://your-backend.onrender.com/api)
# Note: If unset in production and test mode is disabled, the frontend clearly reports backend unreachability.
VITE_API_BASE_URL=http://localhost:5000/api

# Backend Real-time Socket.IO URL
VITE_SOCKET_URL=http://localhost:5000

# Optional: Enable offline frontend test mode by default (defaults to false in production)
# Can also be enabled dynamically anytime by appending ?testMode=true in the URL or via the UI banner
VITE_TEST_MODE=false
